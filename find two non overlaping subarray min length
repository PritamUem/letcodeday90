class Solution:
    def minSumOfLengths(self, arr: list[int], target: int) -> int:
        n = len(arr)
        # min_len[i] stores the minimum length of a valid subarray ending at or before index i
        min_len = [float('inf')] * n

        ans = float('inf')
        curr_sum = 0
        left = 0

        for right in range(n):
            curr_sum += arr[right]

            # Shrink window until curr_sum <= target
            while curr_sum > target and left <= right:
                curr_sum -= arr[left]
                left += 1

            # Check if a valid subarray ending at `right` is found
            if curr_sum == target:
                length = right - left + 1

                # If there is a valid non-overlapping subarray before `left`, update the answer
                if left > 0 and min_len[left - 1] != float('inf'):
                    ans = min(ans, length + min_len[left - 1])

                # Update min_len for the current index
                min_len[right] = min(min_len[right - 1] if right > 0 else float('inf'), length)
            else:
                # Carry forward the minimum length seen so far
                min_len[right] = min_len[right - 1] if right > 0 else float('inf')

        return ans if ans != float('inf') else -1
